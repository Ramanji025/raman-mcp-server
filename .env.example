# ============================================================
# MCP Microservices Knowledge Base - environment configuration
# Copy to .env and adjust values for your local machine.
# ============================================================

# ---- Server ----
MCP_KB_ENV=local
MCP_KB_LOG_LEVEL=INFO
MCP_KB_TRANSPORT=http            # stdio | http
MCP_KB_HTTP_HOST=127.0.0.1
MCP_KB_HTTP_PORT=8000

# ---- CORS (only used when MCP_KB_TRANSPORT=http) ----
CORS_ALLOWED_ORIGINS=*            # local/dev only — MUST set explicit origins in production
# Example for production: CORS_ALLOWED_ORIGINS=https://myapp.example.com,https://admin.example.com
# WARNING: wildcard '*' is blocked by the server if ENV is not 'local', 'dev', or 'development'
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
# ---- Repositories ----
# Root directory where the 19 microservice git repos are cloned.
MCP_KB_REPOS_ROOT=./data/repos
# Optional path to a repos.yaml manifest listing clone URLs.
MCP_KB_REPOS_MANIFEST=./config/repos.yaml

# ---- Git authentication (private HTTPS remotes) ----
# For GitHub/GitLab/Bitbucket, set GIT_TOKEN to a Personal Access Token (PAT).
# GIT_USERNAME can be your username (GitHub also accepts any value with a PAT;
# leave blank to use "oauth2"). These are injected into HTTPS clone/pull URLs.
GIT_USERNAME=****
GIT_TOKEN=****
# Default branch used when a repo entry in repos.yaml omits `branch:`.
GIT_DEFAULT_BRANCH=development

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mcpkb

# ---- Embeddings ----
# provider: fastembed (local, default) | sentence-transformers (local) | openai
# P1.2: bge-base-en-v1.5 (768-dim) improves BEIR recall vs bge-small (384-dim); requires re-ingestion
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=64

# ---- LLM (used by LangGraph agents; optional for pure retrieval) ----
# provider: openai | azure | ollama  (llama.cpp uses the same openai-compatible API as ollama)
LLM_PROVIDER=ollama
LLM_MAX_CONCURRENCY=4
# Some llama.cpp/Ollama servers validate this against the loaded model name and
# return 400 if it doesn't match — set it to the model your server is serving.
# Falls back to "default" if left blank.
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:8080/v1
# Path appended to OLLAMA_BASE_URL for chat completions; change here if a
# gateway/proxy exposes it under a different path.
OLLAMA_GENERATE_URL=/chat/completions
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- PostgreSQL metadata store (optional) ----
POSTGRES_ENABLED=true
POSTGRES_DSN=postgresql://mcpkb:mcpkb@localhost:5432/mcpkb

# ---- Ingestion ----
INGEST_MAX_FILE_SIZE_KB=4096
INGEST_CODE_CHUNK_LINES=512
INGEST_DOC_CHUNK_TOKENS=2048
INGEST_CONCURRENCY=16

GRAPH_BACKEND = "neo4j"
NEO4J_URI = "bolt://localhost:7687"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "admin123"
NEO4J_DATABASE = "neo4j"

# ---- Hybrid retrieval ----
SPARSE_ENABLED=true
SPARSE_MODEL=Qdrant/bm25
# P1.1: reranker ON — bge-reranker-v2-m3 outperforms ms-marco on code/API queries
RERANK_ENABLED=true
RERANK_PROVIDER=cross-encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=30

# ---- Query-time web gap-fill ----
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MIN_CONFIDENCE=0.45
TAVILY_API_KEY=
# Free tier: 2,000 queries/month, no scraping/captchas. Sign up at
# https://brave.com/search/api/. Used before falling back to ddgs scraping.
BRAVE_API_KEY=
# Open-source, self-hosted, free metasearch — recommended if you don't want
# any paid API. Run `docker compose up -d searxng` then set this to
# http://localhost:8889 (native) or http://searxng:8080 (docker network).
SEARXNG_URL=

# ---- Online learning from usage (aliases + retrieval boosts) ----
LEARNING_ENABLED=true

# ---- Observability / security ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=mcp-microservices-kb
OTEL_EXPORTER=console
OTEL_EXPORTER_ENDPOINT=
RBAC_ENABLED=false
RBAC_POLICY_PATH=./config/rbac.yaml
AUDIT_LOG_ENABLED=true
SENSITIVE_SCAN_ENABLED=true

# ---- Prompt-injection guardrail (retrieved code/docs -> LLM context) ----
# mode: sanitize (neutralize + keep chunk) | drop (exclude flagged chunk)
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MODE=sanitize

# ---- LLM observability (Langfuse) ----
# pip install "mcp-microservices-kb[langfuse]" (or: pip install langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- Rally (optional, for analyze_user_story by id) ----
RALLY_API_KEY=***
RALLY_BASE_URL=https://rally1.rallydev.com/slm/webservice/v2.0
RALLY_WORKSPACE_REF=***
RALLY_PROJECT_REF=
